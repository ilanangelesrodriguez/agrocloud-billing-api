NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/agrocloud_billing
# Clave interna de 32+ caracteres compartida SOLO con backend Laravel.
SERVICE_API_KEY=replace-with-a-long-random-service-key-32chars
# Llaves de Culqi Panel: usar sk_test_/pk_test_ en pruebas.
CULQI_MODE=test
CULQI_SECRET_KEY=sk_test_REEMPLAZAR
CULQI_PUBLIC_KEY=pk_test_REEMPLAZAR
CULQI_API_URL=https://api.culqi.com/v2
# Se usa en la URL registrada en Culqi Panel. Generar valor aleatorio de 32+ caracteres.
CULQI_WEBHOOK_TOKEN=replace-with-unique-random-webhook-token-32chars
# Endpoint privado de recepción de eventos en Laravel (HTTPS en producción).
AGROCLOUD_EVENT_URL=
AGROCLOUD_EVENT_SECRET=replace-with-a-long-random-event-secret-32chars
OUTBOX_INTERVAL_MS=30000

# Documentación pública en /docs y contrato OpenAPI en /openapi.json.
SWAGGER_ENABLED=true
